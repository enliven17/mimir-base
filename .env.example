# =============================================================================
# Mimir — environment variables (copy to .env.local; never commit secrets)
# =============================================================================

# ── Base Sepolia contract ─────────────────────────────────────────────────────
# Deployed Mimir.sol address on Base Sepolia (chain 84532)
# Printed by: npm run deploy:contract
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Block number where the contract was deployed. Log scans for the agents/stats
# pages paginate starting from this block. Defaults to 0 (full history).
# NEXT_PUBLIC_DEPLOY_BLOCK=0

# Base Sepolia RPC. The public https://sepolia.base.org default is rate-limited
# and is LOCAL-ONLY — every deployed environment must set a provider endpoint
# (CDP / Alchemy / QuickNode) or the feed will 429.
# NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL=https://sepolia.base.org   # server-only

# eth_getLogs tuning — providers cap block ranges (commonly 10k, some 2k).
# BASE_LOG_CHUNK=5000
# BASE_LOG_CONCURRENCY=8

# Official Base Sepolia USDC (6 decimals) — market stakes, payouts, x402.
# Defaults to Circle's address; override only for a local fork.
# NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── x402 (paid endpoints) ─────────────────────────────────────────────────────
# CAIP-2 network id. Defaults to eip155:84532.
# X402_NETWORK=eip155:84532

# Facilitator that verifies + settles payments. x402.org needs no signup and is
# fine for testnet; staging/production should use CDP.
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_TIMEOUT_MS=20000

# CDP facilitator credentials — SERVER-SIDE ONLY, never NEXT_PUBLIC_.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Optional gas sponsorship for Base Account. NOT a bundler — the Base Account SDK
# submits through the wallet's own infrastructure and takes no bundler URL; this is
# forwarded as the ERC-5792 paymasterService capability. Without it a sub account
# pays its own gas in ETH. Issued by portal.cdp.coinbase.com.
# NEXT_PUBLIC_PAYMASTER_URL=

# ── Wallet connect ────────────────────────────────────────────────────────────
# WalletConnect Cloud project id — powers the QR code path in the ConnectKit
# modal so any of the 380+ WC-compatible mobile wallets can connect. Get one
# free at https://cloud.walletconnect.com (~30 second signup).
# Without this var the modal still shows browser-extension wallets (MetaMask,
# Coinbase, Rainbow, Phantom, Trust, Brave, OKX, etc.) — only the mobile QR
# entry is hidden.
# NEXT_PUBLIC_WC_PROJECT_ID=

# ── Agent wallets (workers only — NEVER expose to the web server) ─────────────
# Generate all twelve in one pass:
#   npm run agents:create-wallets
# Fund them from one master wallet (CDP faucet tops up the master with test
# USDC + a little Base Sepolia ETH for gas):
#   FUNDER_PRIVATE_KEY=0x... npm run agents:fund
# Check balances:
#   npm run agents:balances
# ORACLE_PRIVATE_KEY=0x...
# CREATOR_PRIVATE_KEY=0x...

# ── Paid-resource seller (web server) ────────────────────────────────────────
# Default x402 payTo for paid endpoints (usually the oracle address). Council
# routes override this per request so each persona is paid into its own wallet.
# Written automatically by agents:create-wallets together with the ten
# COUNCIL_<SLUG>_ADDRESS vars — all public, safe for Vercel env.
# SELLER_ADDRESS=0x...
# Secret that signs council passes (any random 32+ byte string).
# PASS_SECRET=<random-hex>
# COUNCIL_PASS_TTL_MS=600000    # council pass lifetime (default 10 min)

# Revenue counters resume on top of these (both unset = start at zero, which is
# what the Base migration wants).
# PAYMENTS_BASELINE_CALLS=
# PAYMENTS_BASELINE_USDC=

# ── Oracle AI agent ───────────────────────────────────────────────────────────
# Required env: ORACLE_PRIVATE_KEY
#               + ONE of GEMINI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY / GROQ_API_KEYS / OPENROUTER_API_KEY

# LLM provider — only ONE key is needed; Gemini is preferred when present.
# Force a specific provider with LLM_PROVIDER=gemini|anthropic|groq|openrouter.
# Override the default model with ORACLE_LLM_MODEL.
# GEMINI_API_KEY=...                       # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=sk-ant-...             # https://console.anthropic.com
# LLM_PROVIDER=gemini
# Optional worker-scoped primary keys. When one is set, that worker uses only
# its own key; the shared ring is used only by unscoped processes.
# ORACLE_GEMINI_API_KEY=...
# CREATOR_GEMINI_API_KEY=...
# COUNCIL_GEMINI_API_KEY=...
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
# ORACLE_LLM_MODEL=gemini-3.5-flash-lite   # legacy worker override
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.7-flash
# LLM_FALLBACK_PROVIDERS=gemini             # keep quota failures from hitting an unconfigured provider
# LLM_QUOTA_COOLDOWN_MS=300000
# ORACLE_LLM_THROTTLE_MS=8000              # oracle LLM calls, default 8s apart
# ORACLE_SETTLEMENT_DELAY_MS=900000        # settle expired claims 15 min apart

# Auto-challenger: oracle automatically stakes on mispriced open claims
# AUTO_CHALLENGE=1
# CHALLENGE_STAKE_USDC=2        # USDC per auto-challenge (default: 2)
# CHALLENGE_CONFIDENCE=80       # min confidence to challenge (default: 80)

# Paid evidence: the oracle buys paywalled resolution sources over x402 (USDC)
# PAY_EVIDENCE=1                # default on
# EVIDENCE_POOL_BPS=50          # budget = 0.5% of the claim's pot
# EVIDENCE_MAX_USDC=0.05         # hard ceiling per source
# EVIDENCE_MIN_USDC=0.001        # floor (still pay tiny sources)

# Council-as-jury settlement: oracle buys persona verdicts before settling
# COUNCIL_SETTLEMENT=1
# MIMIR_BASE_URL=http://localhost:3000   # where the paid /api/council/* routes live
# COUNCIL_QUORUM=3
# COUNCIL_VOTE_CAP_USDC=0.005
# Self-resolving jury (sequential votes + cross-entropy bonuses)
# COUNCIL_SELF_RESOLVING=1
# COUNCIL_ALPHA=0.25
# COUNCIL_BONUS_USDC=0.01

# Sibyl Memory sidecar. Entity memory is load-bearing; event history is
# optional and disabled in production to avoid duplicating every decision.
# SIBYL_MEMORY_DB=~/.sibyl-memory/memory.db
# SIBYL_MEMORY_HOST=127.0.0.1
# SIBYL_MEMORY_PORT=8788
# SIBYL_REQUIRED=1
# SIBYL_EVENT_LOG=0

# ── Market-creator agent ──────────────────────────────────────────────────────
# CREATOR_STAKE_USDC=2          # USDC stake per market
# MAX_CLAIMS_PER_RUN=5
# MAX_ACTIVE_CLAIMS=30
# RUN_INTERVAL_HOURS=6
# MARKET_CREATOR_PREFLIGHT=1    # buy council opinions before opening markets
# MARKET_CREATOR_PREFLIGHT_MIN_SCORE=60
# MARKET_CREATOR_PREFLIGHT_CAP_USDC=0.005

# ── Demo mode (no MetaMask needed) ───────────────────────────────────────────
# Enable demo relay: NEXT_PUBLIC_DEMO_MODE=1
# NEXT_PUBLIC_DEMO_MODE=1
# NEXT_PUBLIC_DEMO_MODE_LABEL=Base Sepolia demo

# Server-side demo signers (private keys funded on Base Sepolia)
# DEMO_CREATOR_PRIVATE_KEY=0x...
# DEMO_CHALLENGER_PRIVATE_KEY=0x...
# DEMO_SIGNER_PRIVATE_KEY=0x...     # fallback for all actions


# ── XMTP messaging (E2E encrypted chat) ──────────────────────────────────────
# NEXT_PUBLIC_XMTP_ENV=dev          # local | dev | production
# NEXT_PUBLIC_FEATURE_XMTP=1
# NEXT_PUBLIC_XMTP_APP_VERSION=mimir/0.1.0

# ── Mimir Council (10 AI personas as economic actors) ────────────────────────
# The ten persona wallets are generated by npm run agents:create-wallets, which
# writes COUNCIL_<SLUG>_PRIVATE_KEY (workers) + COUNCIL_<SLUG>_ADDRESS (web)
# pairs for each persona. The worker starts with:
#   npm run council          # standalone
#   npm run workers          # bundled with oracle + market-creator
#
# Tunables (all optional; defaults are demo-friendly):
# COUNCIL_POLL_INTERVAL_MS=180000   # cycle interval in ms (default 3 min)
# COUNCIL_MAX_CLAIMS=1              # max claims per cycle, deadline-sorted
# COUNCIL_DECISION_DELAY_MS=30000   # gap between persona decisions/stakes
# COUNCIL_LLM_THROTTLE_MS=8000      # min ms between LLM calls inside a persona
# COUNCIL_PEER_READS=0              # 1 = personas buy other personas' reasoning
# COUNCIL_PEER_READS_PER_PERSONA=2  # peer reads bought before each persona decision
# COUNCIL_PEER_READ_DELAY_MS=15000  # gap between peer-read payments
# COUNCIL_PEER_READ_CAP_USDC=0.003   # max total quote accepted per peer read
# COUNCIL_PERSONAS_ACTIVE=          # optional CSV subset of slugs
# COUNCIL_PHILOSOPHERS=0            # run the classic jury alone (default: both)
# MARKET_CREATOR_MAX_PER_MODE=3      # markets per settlement mode per run
# MARKET_CREATOR_MAX_PER_CREATOR=3   # markets per creator address per run
# MARKET_CREATOR_AUTONOMOUS=1        # publish for real; default is proposal-only
#                                    # shadow mode until review precision is known
# COUNCIL_PHILOSOPHERS_ACTIVE=      # optional CSV subset of philosopher slugs

# The worker-side key pairs look like this after the script runs
# (one per persona; SLUG is the kebab→UPPER form of the persona id):
# COUNCIL_OPTIMIST_PRIVATE_KEY=0x...
# COUNCIL_PESSIMIST_PRIVATE_KEY=0x...
# COUNCIL_CONTRARIAN_PRIVATE_KEY=0x...
# COUNCIL_STATISTICIAN_PRIVATE_KEY=0x...
# COUNCIL_WHALE_WATCHER_PRIVATE_KEY=0x...
# COUNCIL_CRYPTO_MAXI_PRIVATE_KEY=0x...
# COUNCIL_SPORTS_PUNDIT_PRIVATE_KEY=0x...
# COUNCIL_WEATHERMAN_PRIVATE_KEY=0x...
# COUNCIL_DOOMER_PRIVATE_KEY=0x...
# COUNCIL_YAPPER_PRIVATE_KEY=0x...

# ── Neon Postgres (server-side read index, optional) ─────────────────────────
# Contract state is always source of truth. Neon is a cache/read index used
# by /explorer, /dashboard, and the challenge-opportunities API. Mimir boots
# fine without it — the affected routes return 500 and other pages still work.
# Provision a free DB at https://console.neon.tech, then paste the
# pooler connection string here (it already includes ?sslmode=require).
# DATABASE_URL=postgresql://<user>:<pwd>@<host>/<db>?sslmode=require
# Guards /api/cron/sync, the manual trigger for the read-index reconcile that the
# `sync` worker (agents/sync/index.ts) also runs on its own interval. The route
# fails closed without it. Send as `Authorization: Bearer <CRON_SECRET>`.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
# Read-index reconcile cadence for the sync worker. Above 300000 the health probe
# starts warning that the index is stale.
# SYNC_POLL_INTERVAL_MS=300000

# ── Claim generation (AI-assisted create flow) ────────────────────────────────
# NEXT_PUBLIC_FEATURE_SOURCE_DRAFTS=1
# GEMINI_API_KEY=
# CLAIM_DRAFT_MODEL=gemini-3.5-flash-lite

# ── Moderation ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_FEATURE_CLAIM_MODERATION=1
# CLAIM_MODERATION_MODEL=gemini-3.5-flash-lite

# ── Product analytics (PostHog) ───────────────────────────────────────────────
# Analytics is opt-in: with no key set, capture is a no-op and nothing is sent.
# Events go browser -> /api/analytics/event -> PostHog, so no SDK ships to the
# client and the actor salt never leaves the server.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com
# ANALYTICS_DISABLED=1                    # hard kill switch, overrides the key

# Wallet addresses are NEVER sent. They are hashed with this salt into a stable
# actor id. Server-only — a public salt is trivially reversible over a public
# chain's address space. Rotating it permanently severs the old identities.
# ANALYTICS_ACTOR_SALT=<random-hex>

# Keeps preview/CI traffic out of production metrics. Defaults to "test" unless
# VERCEL_ENV=production.
# ANALYTICS_ENVIRONMENT=test

# Internal test wallets, comma separated. Tagged is_internal so they can be
# cohorted out instead of inflating conversion.
# ANALYTICS_INTERNAL_ADDRESSES=0x...,0x...

# ── Research Gateway (agent web access) ───────────────────────────────────────
# Agents never fetch the web directly; every request goes through the gateway so
# SSRF, response size, redirects and per-agent budgets are enforced server-side.
#
# Optional allowlist. When set, ONLY these domains (and their subdomains) are
# fetchable — the safest posture for autonomous agents.
# RESEARCH_ALLOWED_DOMAINS=coingecko.com,api.weather.gov,github.com
# Always refused, even if the allowlist would permit them. Deny wins over allow.
# RESEARCH_DENIED_DOMAINS=

# Per-agent budgets, per rolling hour.
# RESEARCH_MAX_REQUESTS_PER_AGENT=120
# RESEARCH_MAX_BYTES_PER_AGENT=8388608
# RESEARCH_CACHE_TTL_MS=300000

# ── Market-creator autonomy ───────────────────────────────────────────────────
# Autonomous publishing is OPT-IN. Unset, the creator runs proposal-only (shadow
# mode) and every candidate is held for human review — the roadmap gates
# autonomous publish behind measured shadow precision.
# MARKET_CREATOR_AUTONOMOUS=1
# MARKET_CREATOR_MAX_ACTIVE=30
# MARKET_CREATOR_MAX_EXPOSURE_USDC=100
# MARKET_CREATOR_MAX_PER_CATEGORY=2

# ── Incident kill switches ────────────────────────────────────────────────────
# create / stake / copy / x402 pause INDEPENDENTLY. A single maintenance mode is
# useless in practice: a degraded facilitator should stop paid endpoints while
# settlement keeps working, and a pricing bug should stop new stakes without
# freezing payouts.
#
# Withdrawal and read paths have NO switch by design — users must always be able
# to pull a parked payout, and a status page nobody can reach is not a status page.
# MIMIR_PAUSE_STAKE=1
# MIMIR_PAUSE_STAKE_REASON=payout preview mismatch under investigation
# MIMIR_PAUSE_CREATE_MARKET=1
# MIMIR_PAUSE_COPY_EXECUTION=1
# MIMIR_PAUSE_X402_SELLING=1
# MIMIR_PAUSE_X402_BUYING=1
# MIMIR_PAUSE_AGENT_REGISTRATION=1
# MIMIR_PAUSE_MARKET_CREATOR_WORKER=1
# MIMIR_PAUSE_COUNCIL_WORKER=1
# MIMIR_PAUSE_ORACLE_SETTLEMENT=1
# Everything at once (still cannot touch withdraw/reads):
# MIMIR_PAUSE_ALL=1
# MIMIR_PAUSE_REASON=incident in progress

# ── Feature flags ─────────────────────────────────────────────────────────────
# Only "1" enables and "0" disables; any other value falls back to the default, so
# a typo cannot silently switch on a money-moving feature.
# These three are OFF by default until their review gates are met:
# MIMIR_FEATURE_BYOA_FUNDED_ACTIONS=1
# MIMIR_FEATURE_COPY_TRADING=1
# MIMIR_FEATURE_AGENT_BASKETS=1
# MIMIR_FEATURE_FEE_POLICY=1          # needs the audited MimirV2 escrow deployed first

# ── Restricted topic compliance gates ─────────────────────────────────────────
# Elections and public policy are real topics but regulated in many jurisdictions
# and a manipulation target, so each needs its own explicit decision.
# MIMIR_COMPLIANCE_ALLOW_ELECTIONS=1
# MIMIR_COMPLIANCE_ALLOW_POLICY=1

# ── Per-category operational kill switch ──────────────────────────────────────
# Stops NEW markets in one category without a deploy. Settlement of markets
# already staked in it is unaffected — a switch that trapped existing funds would
# be worse than the problem it was flipped for.
# MIMIR_DISABLE_CATEGORY_CRYPTO=1
# MIMIR_DISABLE_CATEGORY_SPORTS=1

# ── Virtuals ACP v2 seller worker ───────────────────────────────────────────
# Register the seller and its offering at https://app.virtuals.io/acp/new.
# These secrets belong only in the Railway workers service, never in Vercel.
# VIRTUALS_ACP_ENABLED=0
# VIRTUALS_ACP_CHAIN_ID=8453
# VIRTUALS_ACP_SERVER_URL=https://api.acp.virtuals.io
# VIRTUALS_ACP_OFFERING_NAME=mimir_market_intelligence
# VIRTUALS_ACP_SELLER_WALLET_ADDRESS=0x...
# VIRTUALS_ACP_SELLER_WALLET_ID=
# VIRTUALS_ACP_SELLER_SIGNER_PRIVATE_KEY=REPLACE_WITH_VIRTUALS_SIGNER_KEY
# VIRTUALS_ACP_SELLER_BUILDER_CODE=bc-...
# VIRTUALS_ACP_MAX_RECOMMENDED_STAKE_USDC=10

# ── Virtuals ACP v2 demo buyer ──────────────────────────────────────────────
# Use a different registered wallet from the seller for the demo.
# VIRTUALS_ACP_BUYER_WALLET_ADDRESS=0x...
# VIRTUALS_ACP_BUYER_WALLET_ID=
# VIRTUALS_ACP_BUYER_SIGNER_PRIVATE_KEY=REPLACE_WITH_VIRTUALS_SIGNER_KEY
# VIRTUALS_ACP_BUYER_BUILDER_CODE=bc-...
# VIRTUALS_ACP_SELLER_WALLET_ADDRESS=0x...
# VIRTUALS_ACP_DEMO_URL=https://example.com/source
# VIRTUALS_ACP_DEMO_QUESTION=Will the cited source support this claim by the deadline?
# VIRTUALS_ACP_DEMO_STAKE_USDC=2
# VIRTUALS_ACP_REQUIREMENT_JSON={"claimQuestion":"...","resolutionUrl":"https://example.com/source"}
#
# Health outcomes, death/violence, private individuals and illegal activity are
# BLOCKED with no override. They are out of scope because they are wrong to run as
# prediction markets, not because the plumbing is unfinished — there is no env var.
